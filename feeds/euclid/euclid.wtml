      <ImageSet BandPass="Multi" BaseDegreesPerTile="45.893162934761264" BaseTileLevel="0" BottomsUp="False" CenterX="92.22719299284223" CenterY="-39.79577345155554" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Mosaic of Euclid observations in the Southern Sky" OffsetX="0.0028010963705298623" OffsetY="0.0028010963705298623" Projection="Tan" QuadTreeMap="" Rotation="74.38220739347688" Sparse="True" StockSet="False" TileLevels="6" Url="https://data1.wwtassets.org/feeds/euclid/ensci_euclid20241015a/L{1}X{2}Y{3}.png" WidthFactor="2" Xbands="Visible,IR" Xdominant_band="IR" Xastropix_ids="ensci|euclid20241015a" Xcorepipe_ids="euclid|ensci_euclid20241015a">
