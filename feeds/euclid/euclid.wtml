      <ImageSet BandPass="Multi" BaseDegreesPerTile="1.3651771392" BaseTileLevel="0" BottomsUp="False" CenterX="328.4088961222786" CenterY="17.687196494444446" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Euclid’s view of galaxy cluster Abell 2390" OffsetX="4.16619e-05" OffsetY="4.16619e-05" Projection="Tan" QuadTreeMap="" Rotation="-26.45409999999995" Sparse="True" StockSet="False" TileLevels="6" Url="https://data1.wwtassets.org/feeds/euclid/ensci_euclid20240523d/L{1}X{2}Y{3}.png" WidthFactor="2" Xbands="Visible,IR" Xdominant_band="IR" Xastropix_ids="ensci|euclid20240523d" Xcorepipe_ids="euclid|ensci_euclid20240523d">
