        <CreditsUrl>https://esahubble.org/images/potw1941a/</CreditsUrl>
        <ThumbnailUrl>https://data1.wwtassets.org/feeds/hst/potw1941a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
