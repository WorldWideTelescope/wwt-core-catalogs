  <Place Angle="0" AngularSize="0" Constellation="CYG" DataSetType="Sky" Dec="42.235883842406075" Magnitude="0" Name="NGC 7027" Opacity="100" RA="21.117165977062104" Rotation="0" Thumbnail="https://data1.wwtassets.org/feeds/hst/heic2011c/thumb.jpg" ZoomLevel="0.139917146664">
    <Description>This image from the NASA/ESA Hubble Space Telescope depicts NGC 7027, or the “Jewel Bug” nebula. The object had been slowly puffing away its mass in quiet, spherically symmetric or perhaps spiral patterns for centuries — until relatively recently when it produced a new cloverleaf pattern. New observations of the object have found unprecedented levels of complexity and rapid changes in the jets and gas bubbles blasting off of the star at the centre of the nebula.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.02249252864" BaseTileLevel="0" BottomsUp="False" CenterX="316.757247896" CenterY="42.2363596289" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 7027" OffsetX="-0.00020297091630660312" OffsetY="-0.00047155422074139083" Projection="Tan" QuadTreeMap="" Rotation="2.916422405160001" Sparse="True" StockSet="False" TileLevels="3" Url="https://data1.wwtassets.org/feeds/hst/heic2011c/L{1}X{2}Y{3}.png" WidthFactor="2" Xcorepipe_ids="hst|heic2011c">
        <Credits>NASA, ESA, and J. Kastner (RIT)</Credits>
        <CreditsUrl>https://esahubble.org/images/heic2011c/</CreditsUrl>
        <ThumbnailUrl>https://data1.wwtassets.org/feeds/hst/heic2011c/thumb.jpg</ThumbnailUrl>
