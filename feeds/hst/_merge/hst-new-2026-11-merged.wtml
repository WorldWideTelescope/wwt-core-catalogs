        <ThumbnailUrl>https://data1.wwtassets.org/feeds/hst/potw1945a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="0" Constellation="APS" DataSetType="Sky" Dec="-78.19198684076312" Magnitude="0" Name="The Sunburst Arc" Opacity="100" RA="15.835277336651513" Rotation="0" Thumbnail="https://data1.wwtassets.org/feeds/hst/heic1920a/thumb.jpg" ZoomLevel="0.4011395264241334">
    <Description>This image, taken with the NASA/ESA Hubble Space Telescope, shows a massive galaxy cluster, about 4.6 billion light years away. Along its borders four bright arcs are visible; these are copies of the same distant galaxy, nicknamed the Sunburst Arc. The Sunburst Arc galaxy is almost 11 billion light-years away and the light from it is being lensed into multiple images by gravitational lensing. The Sunburst Arc is among the brightest lensed galaxies known and its image is visible at least 12 times within the four arcs. Three arcs are visible in the top right of the image, the fourth arc in the lower left. The last one is partially obscured by a bright foreground star, which is located in the Milky Way.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.06822746676936703" BaseTileLevel="0" BottomsUp="False" CenterX="237.529182083" CenterY="-78.1919906294" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="The Sunburst Arc" OffsetX="4.164274094809999e-06" OffsetY="4.164274094809999e-06" Projection="Tan" QuadTreeMap="" Rotation="-4.9600000000000355" Sparse="True" StockSet="False" TileLevels="5" Url="https://data1.wwtassets.org/feeds/hst/heic1920a/L{1}X{2}Y{3}.png" WidthFactor="2" Xcorepipe_ids="hst|heic1920a">
        <Credits>ESA/Hubble, NASA, Rivera-Thorsen et al.</Credits>
        <CreditsUrl>https://esahubble.org/images/heic1920a/</CreditsUrl>
        <ThumbnailUrl>https://data1.wwtassets.org/feeds/hst/heic1920a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
