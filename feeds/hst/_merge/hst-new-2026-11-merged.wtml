      <ImageSet BandPass="IR" BaseDegreesPerTile="0.03414115975589888" BaseTileLevel="0" BottomsUp="False" CenterX="277.495459523" CenterY="1.23977835289" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Bat Shadow (2018 Observation)" OffsetX="8.33524408103e-06" Projection="Tan" QuadTreeMap="" Rotation="-12.02000000000001" Sparse="True" StockSet="False" TileLevels="4" Url="https://data1.wwtassets.org/feeds/hst/heic2012a/L{1}X{2}Y{3}.png" WidthFactor="2" Xcorepipe_ids="hst|heic2012a">
